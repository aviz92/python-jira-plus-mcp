JIRA_BASE_URL='instance_name.atlassian.net'
JIRA_USER_NAME='your username'
JIRA_TOKEN='your token'
JIRA_DEPLOYMENT=cloud            # cloud | on_premise
JIRA_SSO=false
JIRA_VERIFY_SSL=true

JIRA_MCP_READ_ONLY=true
JIRA_MCP_ENABLE_DELETE=false
JIRA_MCP_ALLOWED_PROJECTS=       # optional, e.g. PROJ1,PROJ2
JIRA_MCP_TRANSPORT=stdio         # stdio | streamable-http
JIRA_MCP_MAX_RESULTS=100
